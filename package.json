{
  "name": "neko-core",
  "version": "0.24.14",
  "description": "Mot chu meo trong terminal, chi muon meo meo - va lam viec. Local-first, config-first, offline-capable.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Meiiie (The Wiii Lab)",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "keywords": [
    "llm",
    "agent",
    "cli",
    "local-first",
    "offline",
    "coding-agent"
  ],
  "bin": {
    "neko": "bin/neko-source.cjs",
    "neko-core": "bin/neko-source.cjs"
  },
  "scripts": {
    "neko": "node bin/neko-source.cjs",
    "eval:terminal": "bun scripts/harbor-eval.ts",
    "lab:antigravity-contract": "bun scripts/antigravity-contract-lab.ts",
    "build": "bun scripts/build.ts && dist/neko __uiprobe && bun scripts/input-probe.ts && bun scripts/acp-smoke.ts",
    "test": "bun test",
    "lint": "oxlint",
    "eval:office": "bun test/office-value-eval.ts",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "typecheck:stable": "bun node_modules/typescript5/bin/tsc --noEmit",
    "package:browser": "bun scripts/package-browser-extension.ts",
    "verify": "bun run typecheck:stable && bun test"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "ink-testing-library": "^4.0.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.1-rc",
    "typescript5": "npm:typescript@^5.9.3",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ink": "^7.1.0",
    "react": "^19.2.7",
    "react-devtools-core": "^7.0.1"
  }
}

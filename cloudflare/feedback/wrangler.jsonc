{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "neko-feedback",
  "main": "worker.ts",
  "account_id": "a7cec31eaddd4eb5858167c4aa7d0bca",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "neko-feedback.holilihu.online", "custom_domain": true }],
  "send_email": [{ "name": "EMAIL", "destination_address": "meiiiekhp888@gmail.com", "allowed_sender_addresses": ["neko-feedback@holilihu.online"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "neko-feedback", "database_id": "8bb64a16-d6f4-4c77-a60e-c919de969495", "migrations_dir": "migrations" }],
  "ratelimits": [{ "name": "INGRESS", "namespace_id": "195071", "simple": { "limit": 30, "period": 60 } }],
  "secrets": { "required": ["IP_HASH_KEY"] },
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 } }
}
